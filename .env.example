# ──────────────────────────────────────────────
# SkillScan 环境变量配置示例（.env.example）
# 复制为 .env.dev / .env.test / .env.prod 使用
# ──────────────────────────────────────────────
# 应用环境 (dev / test / prod)
APP_ENV=dev

# ════════════════════════════════════════════════
# LLM 审查 API（质量优先，如 gpt-4o）
# ════════════════════════════════════════════════
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_TIMEOUT=120
LLM_MAX_TOKENS=8192

# ════════════════════════════════════════════════
# LLM 翻译 API（快速模型，如 gpt-4o-mini）
# 不设置则复用审查 LLM 的配置
# ════════════════════════════════════════════════
TRANSLATE_LLM_API_URL=
TRANSLATE_LLM_API_KEY=
TRANSLATE_LLM_MODEL=
TRANSLATE_LLM_TIMEOUT=60
TRANSLATE_LLM_MAX_TOKENS=2048
